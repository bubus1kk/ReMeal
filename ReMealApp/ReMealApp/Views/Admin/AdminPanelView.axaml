<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReMealApp.ViewModels.Admin"
             x:Class="ReMealApp.Views.Admin.AdminPanelView"
             x:DataType="vm:AdminPanelViewModel">

    <Border Classes="card">
        <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Администрирование"
                               Classes="section-title"/>
                    <TextBlock Text="Пользователи"
                               Foreground="#AAB9B0"
                               FontSize="14"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Обновить"
                        Command="{Binding LoadCommand}"/>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#DDE8DF"
                       FontSize="14"
                       TextWrapping="Wrap"/>

            <Grid IsVisible="{Binding HasAccess}"
                  RowDefinitions="Auto,*"
                  RowSpacing="12">
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Text="Роль"
                               Foreground="#DCE7DD"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <ComboBox Width="220"
                              ItemsSource="{Binding RoleFilters}"
                              SelectedItem="{Binding SelectedRoleFilter, Mode=TwoWay}"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Users}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal"
                          IsVisible="{Binding HasUsers}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Логин"
                                            Binding="{Binding Login}"
                                            Width="*"/>
                        <DataGridTextColumn Header="ФИО"
                                            Binding="{Binding FullName}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Телефон"
                                            Binding="{Binding Phone}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Роль"
                                            Binding="{Binding RoleText}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Активность"
                                            Binding="{Binding ActivityStatusText}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1"
                           Text="По выбранному фильтру пользователей нет."
                           Foreground="#AAB9B0"
                           FontSize="14"
                           IsVisible="{Binding !HasUsers}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
