<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReMealApp.ViewModels.Booking"
             xmlns:dto="using:Application.DTOs.Booking"
             x:Class="ReMealApp.Views.Booking.PartnerBookingsView"
             x:DataType="vm:PartnerBookingsViewModel">

    <Border Classes="card">

        <DockPanel>

            <StackPanel DockPanel.Dock="Top"
                        Spacing="12"
                        Margin="0,0,0,12">

                <StackPanel Orientation="Horizontal"
                            Spacing="8">

                    <TextBlock Text="Бронирования клиентов"
                               Classes="section-title"/>

                    <Button Content="Обновить"
                            Command="{Binding LoadBookingsCommand}"/>

                </StackPanel>

                <Grid ColumnDefinitions="*,*,*,*"
                      ColumnSpacing="8">

                    <StackPanel>
                        <TextBlock Text="Выдачи"/>
                        <TextBlock Text="{Binding IssuedBookingsCount}"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Порции"/>
                        <TextBlock Text="{Binding SavedPortions}"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Отходы, кг"/>
                        <TextBlock Text="{Binding PreventedWasteKg, StringFormat={}{0:N1}}"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Отмены"/>
                        <TextBlock Text="{Binding CancelledBookingsCount}"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                </Grid>

            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"/>

            <DataGrid ItemsSource="{Binding Bookings}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Пользователь"
                                        Binding="{Binding UserName}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Набор"
                                        Binding="{Binding LotTitle}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Точка питания"
                                        Binding="{Binding FoodPointName}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Количество"
                                        Binding="{Binding Quantity}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Цена"
                                        Binding="{Binding PriceAtReservation, StringFormat={}{0:N2}}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Дата"
                                        Binding="{Binding ReservedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                        Width="170"/>

                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding StatusText}"
                                        Width="120"/>

                    <DataGridTemplateColumn Header="Подтвердить"
                                            Width="140">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate x:DataType="dto:BookingDto">

                                <Button
                                    Content="Выдано"
                                    Command="{Binding $parent[UserControl].DataContext.ConfirmBookingCommand}"
                                    CommandParameter="{Binding Id}"
                                    IsVisible="{Binding CanConfirmIssue}" />

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </DockPanel>

    </Border>

</UserControl>
