<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReMealApp.ViewModels.Booking"
             xmlns:dto="using:Application.DTOs.Booking"
             x:Class="ReMealApp.Views.Booking.PartnerBookingsView"
             x:DataType="vm:PartnerBookingsViewModel">

    <UserControl.Styles>

        <Style Selector="DataGridCell:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Border.main-card">
            <Setter Property="Background" Value="#09110F"/>
            <Setter Property="BorderBrush" Value="#22322D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style Selector="Border.filter-card">
            <Setter Property="Background" Value="#0B1412"/>
            <Setter Property="BorderBrush" Value="#22322D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style Selector="Border.stats-card">
            <Setter Property="Background" Value="#0C1513"/>
            <Setter Property="BorderBrush" Value="#1E302A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="MinHeight" Value="120"/>
        </Style>

        <Style Selector="Border.stats-icon-green">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#162B1D"/>
            <Setter Property="BorderBrush" Value="#4C923E"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.stats-icon-purple">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#21182F"/>
            <Setter Property="BorderBrush" Value="#7A5AF8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.stats-icon-red">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#30181C"/>
            <Setter Property="BorderBrush" Value="#D94F70"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="TextBox.filter-input">
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#111A18"/>
            <Setter Property="BorderBrush" Value="#2B3B35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EDF6EF"/>
        </Style>

        <Style Selector="ComboBox.filter-combo">
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#111A18"/>
            <Setter Property="BorderBrush" Value="#2B3B35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EDF6EF"/>
        </Style>

        <Style Selector="DatePicker.filter-date">
            <Setter Property="Height" Value="46"/>
        </Style>

        <Style Selector="Button.refresh-btn">
            <Setter Property="Background" Value="#4C923E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.clear-btn">
            <Setter Property="Background" Value="#17211E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderBrush" Value="#2B3B35"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.status-issued">
            <Setter Property="Background" Value="#17341F"/>
            <Setter Property="BorderBrush" Value="#2D7A3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Width" Value="140"/>
        </Style>

        <Style Selector="Border.status-pending">
            <Setter Property="Background" Value="#3A2810"/>
            <Setter Property="BorderBrush" Value="#A86A12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Width" Value="140"/>
        </Style>

        <Style Selector="Border.status-cancelled">
            <Setter Property="Background" Value="#341B1F"/>
            <Setter Property="BorderBrush" Value="#A54658"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Width" Value="140"/>
        </Style>

    </UserControl.Styles>

    <Grid Margin="18">

        <Border Classes="main-card"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <StackPanel Spacing="18">

                <Grid ColumnDefinitions="*,Auto">

                    <StackPanel Spacing="4">

                        <TextBlock Text="Бронирования клиентов"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#F4F8F5"/>

                        <TextBlock Text="Управляйте бронированиями клиентов"
                                   FontSize="14"
                                   Foreground="#8EA19A"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="refresh-btn"
                            Content="Обновить"
                            Command="{Binding LoadBookingsCommand}"
                            VerticalAlignment="Top"/>

                </Grid>

                <Grid ColumnDefinitions="*,*,*,*"
                      ColumnSpacing="14">

                    <Border Classes="stats-card">

                        <Grid ColumnDefinitions="60,*">

                            <Border Classes="stats-icon-green"/>

                            <StackPanel Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Spacing="4">

                                <TextBlock Text="Выдачи"
                                           Foreground="#9EB0A9"
                                           FontSize="14"/>

                                <TextBlock Text="{Binding IssuedBookingsCount}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <Border Grid.Column="1"
                            Classes="stats-card">

                        <Grid ColumnDefinitions="60,*">

                            <Border Classes="stats-icon-green"/>

                            <StackPanel Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Spacing="4">

                                <TextBlock Text="Порции"
                                           Foreground="#9EB0A9"
                                           FontSize="14"/>

                                <TextBlock Text="{Binding SavedPortions}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <Border Grid.Column="2"
                            Classes="stats-card">

                        <Grid ColumnDefinitions="60,*">

                            <Border Classes="stats-icon-purple"/>

                            <StackPanel Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Spacing="4">

                                <TextBlock Text="Отходы"
                                           Foreground="#9EB0A9"
                                           FontSize="14"/>

                                <TextBlock Text="{Binding PreventedWasteKg}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <Border Grid.Column="3"
                            Classes="stats-card">

                        <Grid ColumnDefinitions="60,*">

                            <Border Classes="stats-icon-red"/>

                            <StackPanel Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Spacing="4">

                                <TextBlock Text="Отмены"
                                           Foreground="#9EB0A9"
                                           FontSize="14"/>

                                <TextBlock Text="{Binding CancelledBookingsCount}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

                <Border Classes="filter-card">

                    <Grid ColumnDefinitions="2.1*,1*,1*,1*,Auto"
                          ColumnSpacing="10">

                        <StackPanel Spacing="6">

                            <TextBlock Text="Поиск"
                                       Foreground="#B3BDB8"/>

                            <TextBox Classes="filter-input"
                                     Text="{Binding SearchText}"
                                     Watermark="Поиск по пользователю, набору или точке"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="6">

                            <TextBlock Text="Точка питания"
                                       Foreground="#B3BDB8"/>

                            <ComboBox Classes="filter-combo"
                                      ItemsSource="{Binding FoodPoints}"
                                      SelectedItem="{Binding SelectedFoodPoint}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="6">

                            <TextBlock Text="Статус"
                                       Foreground="#B3BDB8"/>

                            <ComboBox Classes="filter-combo"
                                      ItemsSource="{Binding Statuses}"
                                      SelectedItem="{Binding SelectedStatus}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Spacing="6">

                            <TextBlock Text="Период"
                                       Foreground="#B3BDB8"/>

                            <DatePicker Classes="filter-date"
                                        SelectedDate="{Binding SelectedDate}"/>

                        </StackPanel>

                        <Button Grid.Column="4"
                                Classes="clear-btn"
                                Content="Сбросить"
                                Command="{Binding ClearFiltersCommand}"
                                VerticalAlignment="Bottom"/>

                    </Grid>

                </Border>

                <Border Background="#0B1412"
                        BorderBrush="#22322D"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="520">

                        <DataGrid ItemsSource="{Binding FilteredBookings}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="72">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Пользователь"
                                                    Binding="{Binding UserName}"
                                                    Width="1.5*"/>

                                <DataGridTextColumn Header="Набор"
                                                    Binding="{Binding LotTitle}"
                                                    Width="1.5*"/>

                                <DataGridTextColumn Header="Точка питания"
                                                    Binding="{Binding FoodPointName}"
                                                    Width="1.5*"/>

                                <DataGridTextColumn Header="Кол-во"
                                                    Binding="{Binding Quantity}"
                                                    Width="90"/>

                                <DataGridTextColumn Header="Цена"
                                                    Binding="{Binding PriceAtReservation}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Дата"
                                                    Binding="{Binding ReservedAt}"
                                                    Width="210"/>

                                <DataGridTemplateColumn Header="Статус"
                                                        Width="180">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate x:DataType="dto:BookingDto">

                                            <Grid VerticalAlignment="Center">

                                                <Border Classes="status-issued"
                                                        HorizontalAlignment="Center"
                                                        IsVisible="{Binding IsIssued}">

                                                    <TextBlock Text="● Выдана"
                                                               Foreground="#7DFF72"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"/>

                                                </Border>

                                                <Border Classes="status-pending"
                                                        HorizontalAlignment="Center"
                                                        IsVisible="{Binding IsPending}">

                                                    <TextBlock Text="● Активна"
                                                               Foreground="#FFC14D"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"/>

                                                </Border>

                                                <Border Classes="status-cancelled"
                                                        HorizontalAlignment="Center"
                                                        IsVisible="{Binding IsCancelled}">

                                                    <TextBlock Text="● Отменена"
                                                               Foreground="#FF7C92"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"/>

                                                </Border>

                                            </Grid>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Подтвердить"
                                                        Width="160">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate x:DataType="dto:BookingDto">

                                            <Button Content="Выдать"
                                                    Background="#4C923E"
                                                    Foreground="White"
                                                    CornerRadius="10"
                                                    Padding="14,8"
                                                    BorderThickness="0"
                                                    Command="{Binding $parent[UserControl].DataContext.ConfirmBookingCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    IsVisible="{Binding CanConfirmIssue}"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </ScrollViewer>

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>